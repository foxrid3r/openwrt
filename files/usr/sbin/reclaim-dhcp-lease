#!/bin/sh
# Reclaim one DHCP lease when dnsmasq reports that no addresses are available.
#
# Supports both DHCP configurations created by set-dhcp-range:
#   1. A normal contiguous UCI pool (dhcp.lan.start / dhcp.lan.limit)
#   2. Fragmented ranges in /etc/dnsmasq.d/custom-ranges.conf
#
# The script is deliberately conservative. A lease is reclaimed only when:
#   - its IP address belongs to the currently configured DHCP pool,
#   - the client does not answer a ping,
#   - its MAC is not present in the bridge forwarding database, and
#   - its neighbour entry is not in an active state.
#
# Only one lease is removed per invocation. dnsmasq is then restarted so it
# immediately reloads the modified lease database.

set -u

TAG="dhcp-reclaim"
LEASE_FILE="/tmp/dhcp.leases"
CUSTOM_FILE="/etc/dnsmasq.d/custom-ranges.conf"
LOCK_DIR="/tmp/dhcp-reclaim.lock"
TMP_DIR="/tmp/dhcp-reclaim.$$"
RANGES_FILE="$TMP_DIR/ranges"
CANDIDATES_FILE="$TMP_DIR/candidates"
NEW_LEASE_FILE="$TMP_DIR/dhcp.leases"
LAN_DEVICE="$(uci -q get network.lan.device || true)"
[ -n "$LAN_DEVICE" ] || LAN_DEVICE="br-lan"

log() {
    logger -t "$TAG" -- "$*"
}

cleanup() {
    rm -rf "$TMP_DIR"
    rmdir "$LOCK_DIR" 2>/dev/null || true
}

trap cleanup EXIT INT TERM

# Prevent overlapping runs if several DHCP failures are logged together.
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    log "Reclaim already in progress; ignoring duplicate request"
    exit 0
fi

mkdir -p "$TMP_DIR" || exit 1
: > "$RANGES_FILE"
: > "$CANDIDATES_FILE"

is_uint() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

is_ipv4() {
    echo "$1" | awk -F. '
        NF != 4 { valid=0; exit }
        BEGIN { valid=1 }
        {
            for (i = 1; i <= 4; i++) {
                if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255) {
                    valid=0
                    exit
                }
            }
        }
        END { exit valid ? 0 : 1 }
    '
}

ip_to_int() {
    echo "$1" | awk -F. '{ printf "%.0f\n", ($1*16777216)+($2*65536)+($3*256)+$4 }'
}

int_to_ip() {
    awk -v n="$1" 'BEGIN {
        a = int(n / 16777216); n -= a * 16777216;
        b = int(n / 65536);    n -= b * 65536;
        c = int(n / 256);      n -= c * 256;
        printf "%d.%d.%d.%d\n", a, b, c, n;
    }'
}

add_range() {
    start_ip="$1"
    end_ip="$2"

    is_ipv4 "$start_ip" || return 1
    is_ipv4 "$end_ip" || return 1

    start_i="$(ip_to_int "$start_ip")"
    end_i="$(ip_to_int "$end_ip")"
    [ "$start_i" -le "$end_i" ] || return 1

    printf '%s %s %s %s\n' "$start_ip" "$end_ip" "$start_i" "$end_i" >> "$RANGES_FILE"
}

load_fragmented_ranges() {
    [ -r "$CUSTOM_FILE" ] || return 1

    # set-dhcp-range writes lines in this exact form:
    # dhcp-range=START_IP,END_IP,12h
    sed -n 's/^[[:space:]]*dhcp-range=\([^,[:space:]]*\),\([^,[:space:]]*\).*/\1 \2/p' "$CUSTOM_FILE" |
    while IFS=' ' read -r start_ip end_ip; do
        [ -n "$start_ip" ] && [ -n "$end_ip" ] && add_range "$start_ip" "$end_ip"
    done

    [ -s "$RANGES_FILE" ]
}

load_uci_range() {
    lan_ip="$(uci -q get network.lan.ipaddr || true)"
    netmask="$(uci -q get network.lan.netmask || true)"
    start="$(uci -q get dhcp.lan.start || true)"
    limit="$(uci -q get dhcp.lan.limit || true)"

    is_ipv4 "$lan_ip" || return 1
    is_ipv4 "$netmask" || return 1
    is_uint "$start" || return 1
    is_uint "$limit" || return 1
    [ "$limit" -gt 0 ] || return 1

    lan_i="$(ip_to_int "$lan_ip")"
    mask_i="$(ip_to_int "$netmask")"
    network_i="$(awk -v a="$lan_i" -v b="$mask_i" 'BEGIN { printf "%.0f\n", and(a,b) }')"
    start_i=$((network_i + start))
    end_i=$((start_i + limit - 1))

    add_range "$(int_to_ip "$start_i")" "$(int_to_ip "$end_i")"
}

ip_is_in_pool() {
    ip="$1"
    is_ipv4 "$ip" || return 1
    ip_i="$(ip_to_int "$ip")"

    awk -v ip="$ip_i" '$3 <= ip && ip <= $4 { found=1; exit } END { exit found ? 0 : 1 }' "$RANGES_FILE"
}

mac_in_fdb() {
    mac="$1"

    if command -v bridge >/dev/null 2>&1; then
        bridge fdb show br "$LAN_DEVICE" 2>/dev/null |
            awk -v mac="$mac" 'BEGIN { IGNORECASE=1 } tolower($1)==tolower(mac) { found=1 } END { exit found ? 0 : 1 }'
        return $?
    fi

    if command -v brctl >/dev/null 2>&1; then
        brctl showmacs "$LAN_DEVICE" 2>/dev/null |
            awk -v mac="$mac" 'BEGIN { IGNORECASE=1 } tolower($2)==tolower(mac) { found=1 } END { exit found ? 0 : 1 }'
        return $?
    fi

    return 1
}

neighbour_is_active() {
    ip="$1"

    command -v ip >/dev/null 2>&1 || return 1

    ip neigh show to "$ip" dev "$LAN_DEVICE" 2>/dev/null |
        awk '
            / (REACHABLE|DELAY|PROBE|PERMANENT|NOARP)( |$)/ { active=1 }
            END { exit active ? 0 : 1 }
        '
}

client_responds() {
    ip="$1"

    command -v ping >/dev/null 2>&1 || return 1
    ping -c 1 -W 1 "$ip" >/dev/null 2>&1
}

client_is_present() {
    mac="$1"
    ip="$2"

    # Generate fresh ARP/neighbour information first.
    if client_responds "$ip"; then
        return 0
    fi

    mac_in_fdb "$mac" && return 0
    neighbour_is_active "$ip" && return 0

    return 1
}

# Prefer the generated custom range file whenever it exists and contains at
# least one valid range. Do not rely solely on dhcp.lan.ignore: the UCI section
# name or value can differ after provisioning, while dnsmasq may still be using
# the custom file through its confdir setting.
#
# If no valid custom ranges exist, fall back to the standard UCI start/limit
# pool. This keeps the reclaimer compatible when set-dhcp-range switches back
# to a single consecutive range and deletes the custom file.
if load_fragmented_ranges; then
    log "Using fragmented DHCP ranges from $CUSTOM_FILE"
else
    : > "$RANGES_FILE"
    if load_uci_range; then
        log "Using standard UCI DHCP range"
    else
        log "Could not determine an active DHCP range from $CUSTOM_FILE or UCI"
        exit 1
    fi
fi

if [ ! -s "$LEASE_FILE" ]; then
    log "No DHCP leases are present to reclaim"
    exit 0
fi

now="$(date +%s)"

# Build a list of active, in-pool leases. Sort by expiration so the lease with
# the least remaining time is considered first. Lease file fields are:
# expiration MAC IP hostname client-id
while IFS=' ' read -r expiry mac ip hostname clientid rest; do
    is_uint "$expiry" || continue
    is_ipv4 "$ip" || continue
    ip_is_in_pool "$ip" || continue

    # Ignore leases already expired; dnsmasq can naturally reuse them.
    [ "$expiry" -gt "$now" ] || continue

    printf '%s %s %s %s %s\n' "$expiry" "$mac" "$ip" "${hostname:--}" "${clientid:--}" >> "$CANDIDATES_FILE"
done < "$LEASE_FILE"

if [ ! -s "$CANDIDATES_FILE" ]; then
    log "No unexpired leases from the configured DHCP pool are eligible for inspection"
    exit 0
fi

sort -n "$CANDIDATES_FILE" -o "$CANDIDATES_FILE"

reclaim_ip=""
reclaim_mac=""
reclaim_host=""

while IFS=' ' read -r expiry mac ip hostname clientid; do
    if client_is_present "$mac" "$ip"; then
        log "Keeping lease $ip ($mac, host $hostname): client still appears connected"
        continue
    fi

    reclaim_ip="$ip"
    reclaim_mac="$mac"
    reclaim_host="$hostname"
    break
done < "$CANDIDATES_FILE"

if [ -z "$reclaim_ip" ]; then
    log "Pool is exhausted, but every inspected lease still appears to belong to a connected client"
    exit 0
fi

# Stop dnsmasq before editing the lease file. If the file were edited while
# dnsmasq was still running, dnsmasq could write its in-memory lease table back
# during shutdown and restore the lease we just removed.
log "Reclaiming lease $reclaim_ip ($reclaim_mac, host $reclaim_host)"

if ! /etc/init.d/dnsmasq stop; then
    log "Could not stop dnsmasq; lease was not modified"
    exit 1
fi

# Remove only the selected IP. Preserve all other lease records verbatim.
if ! awk -v target="$reclaim_ip" '$3 != target { print }' "$LEASE_FILE" > "$NEW_LEASE_FILE"; then
    log "Failed to rewrite $LEASE_FILE"
    /etc/init.d/dnsmasq start >/dev/null 2>&1 || true
    exit 1
fi

chmod 600 "$NEW_LEASE_FILE" 2>/dev/null || true
chown root:root "$NEW_LEASE_FILE" 2>/dev/null || true

if ! mv "$NEW_LEASE_FILE" "$LEASE_FILE"; then
    log "Failed to replace $LEASE_FILE"
    /etc/init.d/dnsmasq start >/dev/null 2>&1 || true
    exit 1
fi

if /etc/init.d/dnsmasq start; then
    log "DHCP lease reclamation completed successfully"
    exit 0
fi

log "Lease was removed, but dnsmasq failed to start"
exit 1
